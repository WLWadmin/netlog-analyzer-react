{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:netlog-analyzer:proposed-sharing-json:v1",
  "title": "Safe sharing JSON v1 — owner-approved D-C-V1 contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "kind", "data"],
  "properties": {
    "schema": { "const": "netlog-analyzer-sharing" },
    "version": { "const": 1 },
    "profile": { "const": "safe-sharing" },
    "kind": { "enum": ["netlog", "go"] },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "netlog" } } },
      "then": { "properties": { "data": { "$ref": "#/definitions/netlogData" } } },
      "else": { "properties": { "data": { "$ref": "#/definitions/goData" } } }
    }
  ],
  "definitions": {
    "fieldState": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "missing" },
            "reason": { "enum": ["absent-property", "undefined-value"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "null" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "valueType", "emptiness"],
          "properties": {
            "state": { "const": "redacted" },
            "valueType": { "const": "string" },
            "emptiness": { "enum": ["empty", "nonempty"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "valueType", "emptiness"],
          "properties": {
            "state": { "const": "redacted" },
            "valueType": { "enum": ["object", "array"] },
            "emptiness": { "const": "uninspected" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "valueType"],
          "properties": {
            "state": { "const": "redacted" },
            "valueType": { "enum": ["number", "boolean"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "uninspected" },
            "reason": { "enum": ["accessor-not-read", "inherited-property-not-read", "unsupported-value", "descriptor-unavailable"] }
          }
        }
      ]
    },
    "proxyRedactions": {
      "type": "object", "additionalProperties": false,
      "required": ["proxySettings", "effectiveProxy", "originalProxy"],
      "properties": {
        "proxySettings": { "$ref": "#/definitions/fieldState" },
        "effectiveProxy": { "$ref": "#/definitions/fieldState" },
        "originalProxy": { "$ref": "#/definitions/fieldState" }
      }
    },
    "bodyRedactions": {
      "type": "object", "additionalProperties": false,
      "required": ["headers", "body", "bodyRaw"],
      "properties": {
        "headers": { "$ref": "#/definitions/fieldState" },
        "body": { "$ref": "#/definitions/fieldState" },
        "bodyRaw": { "$ref": "#/definitions/fieldState" }
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "duration"],
      "properties": {
        "start": { "type": "number" }, "end": { "type": "number" }, "duration": { "type": "number" }
      }
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dns": { "$ref": "#/definitions/phase" }, "connect": { "$ref": "#/definitions/phase" },
        "ssl": { "$ref": "#/definitions/phase" }, "send": { "$ref": "#/definitions/phase" },
        "wait": { "$ref": "#/definitions/phase" }, "download": { "$ref": "#/definitions/phase" }
      }
    },
    "netlogRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "timeline"],
      "properties": {
        "url": { "type": ["string", "null"] }, "method": { "type": "string" },
        "status": { "type": "string" }, "statusCode": { "type": "number" },
        "duration": { "type": "number" }, "error": { "type": "number" },
        "timeline": { "$ref": "#/definitions/timeline" }
      }
    },
    "netlogData": {
      "type": "object", "additionalProperties": false,
      "required": ["exportTime", "overview", "requests", "errors"],
      "properties": {
        "exportTime": { "type": "string", "format": "date-time" },
        "overview": {
          "type": "object", "additionalProperties": false,
          "required": ["totalEvents", "uniqueSources", "peakConcurrency", "urlRequestCount", "errorCount", "warningCount", "slowRequestCount"],
          "properties": {
            "totalEvents": { "type": "integer", "minimum": 0 }, "uniqueSources": { "type": "integer", "minimum": 0 },
            "peakConcurrency": { "type": "number" }, "urlRequestCount": { "type": "integer", "minimum": 0 },
            "errorCount": { "type": "integer", "minimum": 0 }, "warningCount": { "type": "integer", "minimum": 0 },
            "slowRequestCount": { "type": "integer", "minimum": 0 }
          }
        },
        "proxyInfo": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["hasProxy", "proxyType", "isVPN", "redactions"],
          "properties": {
            "hasProxy": { "type": "boolean" }, "proxyType": { "type": ["string", "null"] },
            "pacUrl": { "type": ["string", "null"] }, "proxyList": { "type": "array", "items": { "type": "string" } },
            "proxyFallback": { "type": ["string", "null"] }, "isVPN": { "type": "boolean" },
            "vpnHints": { "type": "array", "items": { "type": "string" } },
            "redactions": { "$ref": "#/definitions/proxyRedactions" }
          }
        },
        "requests": { "type": "array", "items": { "$ref": "#/definitions/netlogRequest" } },
        "errors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["severity", "category", "message", "time"],
            "properties": {
              "severity": { "type": "string" }, "category": { "type": "string" },
              "message": { "type": "string" }, "detail": { "type": "string" }, "time": { "type": "number" }
            }
          }
        }
      }
    },
    "goEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "timestamp", "timestampMs", "worker", "level", "method", "domain", "path", "status", "duration", "durationText", "friendlyName", "rawLine", "redactions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "timestamp": { "type": "string" },
        "timestampMs": { "type": "number" }, "worker": { "type": "string" },
        "level": { "enum": ["Info", "Error", "Warn", "Debug"] }, "method": { "type": "string" },
        "url": { "type": ["string", "null"] }, "domain": { "type": "string" },
        "path": { "type": "string" }, "status": { "enum": ["Success", "Error"] },
        "statusCode": { "type": "number" }, "statusText": { "type": "string" },
        "duration": { "type": "number" }, "durationText": { "type": "string" },
        "friendlyName": { "type": "string" }, "rawLine": { "type": "string" },
        "redactions": { "$ref": "#/definitions/bodyRedactions" }
      }
    },
    "goData": {
      "type": "object", "additionalProperties": false,
      "required": ["exportTime", "total", "identity", "entries"],
      "properties": {
        "exportTime": { "type": "string", "format": "date-time" },
        "total": { "type": "integer", "minimum": 0 },
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "crossFileUnique"],
          "properties": {
            "scope": { "const": "analysis-local" }, "crossFileUnique": { "const": false }
          }
        },
        "entries": { "type": "array", "items": { "$ref": "#/definitions/goEntry" } }
      }
    }
  }
}
