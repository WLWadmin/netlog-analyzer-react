3042385085\"\n          }\n        },\n        \"invite_b2b_type_help_url\": {\n          \"type\": \"url\",\n          \"value\": {\n            \"zh_CN\": \"https://www.feishu.cn/hc/zh-CN/articles/657083794612\",\n            \"en_US\": \"https://www.feishu.cn/hc/en-US/articles/657083794612\",\n            \"ja_JP\": \"https://www.feishu.cn/hc/ja-JP/articles/657083794612\"\n          }\n        },\n        \"team_code_help_url\": {\n          \"type\": \"url\",\n          \"value\": {\n            \"zh_CN\": \"https://www.feishu.cn/hc/zh-cn/articles/360040931334\",\n            \"en_US\": \"https://www.feishu.cn/hc/en-us/articles/360040931334\",\n            \"ja_JP\": \"https://www.feishu.cn/hc/en-us/articles/360040931334\"\n          }\n        },\n        \"member_count_rule_url_feishu_light\": {\n          \"type\": \"image\",\n          \"value\": {\n            \"zh_CN\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_zh.png\",\n            \"en_US\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_en.png\",\n            \"ja_JP\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_jp.png\"\n          }\n        },\n        \"member_count_rule_url_feishu_dark\": {\n          \"type\": \"image\",\n          \"value\": {\n            \"zh_CN\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_zh.png\",\n            \"en_US\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_en.png\",\n            \"ja_JP\": \"https://lf-scm-cn.feishucdn.com/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_jp.png\"\n          }\n        },\n        \"member_count_rule_url_lark_light\": {\n          \"type\": \"image\",\n          \"value\": {\n            \"zh_CN\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_zh.png\",\n            \"en_US\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_en.png\",\n            \"ja_JP\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Light_jp.png\"\n          }\n        },\n        \"member_count_rule_url_lark_dark\": {\n          \"type\": \"image\",\n          \"value\": {\n            \"zh_CN\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_zh.png\",\n            \"en_US\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_en.png\",\n            \"ja_JP\": \"https://sf16-scmcdn.larksuitecdn.com/obj/lark-static-sgsaas/lark/passport/staticfiles/passport/orm_dept_count_detail/Mobile_Dark_jp.png\"\n          }\n        }\n      }\n    },\n    \"all_new_onboarding_guide\": {\n      \"res\": {\n        \"Lark_Guide_SpotlightFeedTitle\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"试试发送一条消息\",\n            \"en_US\": \"Say hello then press Enter!\",\n            \"ja_JP\": \"何でも書いて送信しましょう\"\n          }\n        },\n        \"Lark_Guide_SpotlightCustomerService\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"发送问题关键词，即可得到你想要的答案。\",\n            \"en_US\": \"Try sending a keyword to get an answer to your question\",\n            \"ja _JP\": \"お尋ねの件に関するキーワードを送ると、ボットが対応する返答を返してきます\"\n          }\n        },\n        \"Lark_Guide_SpotlightMyself\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"可以向自己发送文件，转发消息，或记录待办\",\n            \"en_US\": \"Mark your todos, draft messages and replies, or keep files handy.\",\n            \"ja_JP\": \"メッセージの下書き、やることの作成、またはリンクとファイルの手元への保存。\"\n          }\n        },\n        \"Lark_Guide_SpotlightAllStaffGroup\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"这是你的团队全员群，新加入的成员会自动进群。试试给大家留言，或者去邀请更多成员。\",\n            \"en_US\": \"Type a message and tell your team that you are here.\",\n            \"ja_JP\": \"これは全員グループです。メッセージを残すか、他のメンバーを招待してください。\"\n          }\n        },\n        \"Lark_Guide_SpotlightInvitePeopleTeamTitle\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"邀请联系人\",\n            \"en_US\": \"Invite People Here\",\n            \"ja_JP\": \"パートナーを追加\"\n          }\n        },\n        \"Lark_Guide_SpotlightInvitePeopleTeamContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"随时在此处添加联系人、创建群组和文档，即可体验畅快协作。\",\n            \"en_US\": \"Invite people to collaborate in group chats and Docs.\",\n            \"ja_JP\": \"連絡先を追加し、グループチャットやファイルの共有を開始\"\n          }\n        },\n        \"Lark_Guide_SpotlightInvitePeoplePersonalContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"随时在此处添加联系人、创建群组和文档，即可体验畅快协作。\",\n            \"en_US\": \"Invite people to collaborate in group chats and Docs.\",\n            \"ja_JP\": \"連絡先を追加し、グループチャットやファイルの共有を開始\"\n          }\n        },\n        \"Lark_Guide_SpotlightMessengerTitle\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"体验畅快沟通\",\n            \"en_US\": \"Communicate Seamlessly\",\n            \"ja_JP\": \"円滑なコミュニケーション\"\n          }\n        },\n        \"Lark_Guide_SpotlightMessengerContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"支持视频聊天，用表情快速回复特定消息，桌面端和移动端消息实时同步。\",\n            \"en_US\": \"Chat, reply and call from one location on all of your devices.\",\n            \"ja_JP\": \"チャット、通話、履歴の閲覧が複数デバイスでできます\"\n          }\n        },\n        \"Lark_Guide_SpotlightCalendarTitle\": {\n          \"type\": \"string\",\n          \"value\": {\n            \"zh_CN\": \"智能管理日程\",\n            \"en_US\": \"Smart Scheduling\",\n            \"ja_JP\": \"スマートなスケジュール管理\"\n          }\n        },\n        \"Lark_Guide_SpotlightCalendarContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"创建及分享日程便捷高效，还可一键发起会议群聊。\",\n            \"en_US\": \"Effortlessly create, share and transform your calendar experience.\",\n            \"ja_JP\": \"簡単にスケジュールの共有ができ、カレンダーからワンクリックで会議グループチャットを開始\"\n          }\n        },\n        \"Lark_Guide_SpotlightSpaceTitle\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"高效文档协作\",\n            \"en_US\": \"Collaborate on Docs\",\n            \"ja_JP\": \"クラウドでコラボを促進\"\n          }\n        },\n        \"Lark_Guide_SpotlightSpaceContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"支持多人同时编辑，也可在线查看 PDF、Word、Excel 等常见文档。\",\n            \"en_US\": \"Write, share, and develop projects in real time!\",\n            \"ja_JP\": \"安全なクラウド空間で、ファイルの共有や同時編集も簡単です\"\n          }\n        },\n        \"Lark_Guide_SpotlightAppcenterTitle\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"丰富的应用及开放能力\",\n            \"en_US\": \"Apps and Open APIs\",\n            \"ja_JP\": \"多様なアプリとオープンAPI\"\n          }\n        },\n        \"Lark_Guide_SpotlightAppcenterContent\": {\n          \"type\": \"text\",\n          \"value\": {\n            \"zh_CN\": \"审批、打卡、OKR，各种协作工具帮你灵活应对办公难题。\",\n            \"en_US\": \"Add apps and bots, or create your own!\",\n            \"ja_JP\": \"既存のアプリやボットを活用；オープンAPIを通してアプリの開発も可能\"\n          }\n        }\n      }\n    },\n    \"all_new_onboarding_video\": {\n      \"res\": {\n        \"video_ids\": {\n          \"type\": \"video\",\n          \"value\": {\n            \"zh_CN\": \"v029475b0000bno5trslbumd33irsr30\",\n            \"en_US\": \