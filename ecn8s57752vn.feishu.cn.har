file.feishucdn.com/static-resource/v1/v2_25336752-0f18-4912-9422-b32801f86b5g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_31ef62de-2bbf-455f-8f72-f6fa999f998g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_69a2e3ae-68b7-49b8-9fc9-f55a3d22a93g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_0d1772f2-faeb-467a-ad78-5d7c6fcd015g\"],\"snapshotVideos\":[]},\"ja_jp\":{\"additionalRemark\":\"Lingo is an online encyclopedia product that efficiently collects all types of information in the organization and can be edited by all organization members.\\n\\n- Connect organization information: Lingo organizes and compiles topic-specific information including definitions, documents, links, help desks, groups, contacts and more\\n- Accelerate knowledge flow: from \\\"looking for knowledge\\\" to \\\"visited by knowledge\\\", organization members can quickly discover \\\"entries\\\" in chats, documents and search results\\n- Build knowledge network: intelligent algorithms help to suggest and connect more related knowledge to accelerate knowledge update, and build up organization knowledge network\",\"helpUse\":\"https://www.feishu.cn/hc/en-US/articles/855025407592\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_fb639e01-1d0d-41e2-ad5f-92d0fc140fag\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_66c315a6-098f-4ad1-8881-5fce48d76dag\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_d3b90f24-04aa-48fa-a632-227e01c1b46g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_dd914c14-8522-40e4-9be1-9d5feeeff2bg\"],\"snapshotVideos\":[]},\"zh_cn\":{\"additionalRemark\":\"飞书词典是一款高效汇聚企业内各类信息，并可由企业成员参与编辑的在线词典。\\n\\n- 连接企业信息：词典将特定主题的解释说明、文档、链接、服务台、群组、联系人等信息组织汇集\\n- 加速知识流动：从“人找知识”到“知识找人”，成员可以在聊天、文档、搜索时快速发现“词条”\\n- 编织知识网络：智能推荐算法帮助推荐、关联更多企业知识，加速知识更新，构建企业知识网络\",\"helpUse\":\"https://www.feishu.cn/hc/zh-CN/articles/855025407592\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_6dc328be-cde1-4676-8100-37c52e0058fg\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_6d0a4435-03b3-48b2-9187-8b7f7d04f18g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_acae233f-3739-4197-8845-29fc95be93ag\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_0796f9d9-239d-4322-830e-4abd59ff4b7g\"],\"snapshotVideos\":[]}},\"mobileIcon\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_7eb1c59c-61fa-4de8-b340-8c6313f95d0g\",\"name\":{\"en_us\":\"Lingo Assistant\",\"ja_jp\":\"Lingo アシスタント\",\"zh_cn\":\"词条助手\"},\"pcIcon\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_e3241cfe-f905-4288-b11e-338dd54ff8cg\"},{\"appId\":\"cli_a39553a60f3a900b\",\"appName\":{\"en_us\":\"Mermaid\",\"ja_jp\":\"Mermaid\",\"zh_cn\":\"文本绘图\",\"zh_hk\":\"文字繪圖\",\"zh_tw\":\"文字繪圖\"},\"appSceneType\":1,\"blockTypeId\":\"blk_631fefbbae02400430b8f9f4\",\"category\":\"docx_extension\",\"contactInfo\":{\"customApp\":{},\"isvApp\":{\"contactDetail\":{\"corpName\":\"北京飞书科技有限公司\",\"email\":\"support@feishu.cn\",\"i18nAgreement\":{\"en_us\":{\"clauseUrl\":\"https://www.feishu.cn/en/terms\",\"privacyPolicyUrl\":\"https://www.feishu.cn/en/privacy\"},\"ja_jp\":{\"clauseUrl\":\"https://www.feishu.cn/terms\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"},\"zh_cn\":{\"clauseUrl\":\"https://www.feishu.cn/terms\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"}},\"officialUrl\":\"https://www.feishu.cn/\",\"phone\":\"400-0682-666\"},\"i18nIsvInfo\":{\"I18nTenantName\":{},\"TenantName\":\"北京飞书科技有限公司\",\"avatarURL\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_2cab041c-1c0d-4e8f-81c8-cbdc1b7763ag~?image_size=noop\\u0026cut_type=\\u0026quality=\\u0026format=image\\u0026sticker_format=.webp\"}}},\"desc\":{\"en_us\":\"Use the Mermaid charting tool to quickly create various diagrams based on text or code\",\"ja_jp\":\"Mermaid 記法でフローチャート、シーケンス図を簡単に作成\",\"zh_cn\":\"利用 Mermaid 绘图工具，快速创建基于文本代码的流程图、时序图等图形\",\"zh_hk\":\"利用 Mermaid 繪圖工具，快速建立基於文字程式碼的流程圖和循序圖等圖形\",\"zh_tw\":\"利用 Mermaid 繪圖工具，快速建立以文字程式碼為基礎的流程圖、循序圖等圖形\"},\"descImage\":{\"en_us\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_cbb5db6c-9b13-473e-9c85-1ef54d2462dg\",\"ja_jp\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_63751423-59f7-4ea1-a419-cf40cba6609g\",\"zh_cn\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_a8a93af6-abb2-45e1-b92f-b1d5deea4e8g\",\"zh_hk\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_e48889ed-5921-4dad-82c9-2e50ce96054g\",\"zh_tw\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_9c73a3af-5ffc-4685-ad8d-fc27d5f48a4g\"},\"helpInfo\":{\"en_us\":{\"additionalRemark\":\"This block allows you to insert the Mermaid charting tool into documents, enabling you to create complex diagrams such as flowcharts and sequence diagrams with a few lines of text (code).\\n\\n- Review and preview the editing effect in real time and what you see is what you get\\n- A variety of diagram templates are built-in, helping you get started quickly\\n- Three views of are available to adapt to different scenes: code + diagram view, code view, and diagram view\\n- Four theme colors are available to adapt to different document styles\\n- Editing in full screen mode is supported, providing a better editing experience\",\"helpUse\":\"https://www.feishu.cn/hc/en-US/articles/496118428959\",\"snapshotImages\":[\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_50f38a0d-3bd9-414d-a6e3-ab4a791fd57g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_4fd73cb0-b8be-4a01-8eec-89fe3b10c90g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_eb170a2f-3c40-4766-9824-94a9b866fddg\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_828f4611-5f5a-4453-ab95-056ffafdf44g\"],\"snapshotVideos\":[]},\"ja_jp\":{\"additionalRemark\":\"「Mermaid」を利用すれば、ドキュメントに Mermaid 記法を組み込むことができます。フロー図やシーケンス図など複雑なチャートもたった数行のテキスト（コード）だけで描画可能です。\\n\\n- リアルタイムプレビューに対応で、WYSIWYG な編集体験を実現\\n- 豊富な図形テンプレートで、活用を優しくサポート\\n- コード + チャート、コードのみ、チャートのみの 3 つのビューを、シーンに応じて選択可能\\n- さまざまなスタイルに対応した、 5 つのテーマカラーをご用意\\n- フルスクリーン編集可能で、作業効率がさらにアップ\",\"helpUse\":\"https://www.feishu.cn/hc/articles/496118428959\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_825c83d3-37ef-4894-b76f-0acc74bfed8g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_8fe6b687-cf29-4ab9-9a5f-88f1b9a2954g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_c13d059a-ae1f-4bf8-b578-1b847eb14f6g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_e4abc91e-b6ee-4a22-96fb-33d8e533e4eg\"],\"snapshotVideos\":[]},\"zh_cn\":{\"additionalRemark\":\"文本绘图小组件，可以在文档中插入 Mermaid绘图工具，用几行文本（代码）快速创建流程图、时序图等复杂图形\\n\\n- 实时查看预览编辑效果，所见即所得\\n- 内置多种图形模板，助你快速上手\\n- 拥有代码+图形、纯代码、纯图形三种视图，适应不同场景\\n- 四种主题色可选，适配不同文档风格\\n- 可全屏编辑，编辑体验更佳\",\"helpUse\":\"https://www.feishu.cn/hc/zh-CN/articles/496118428959\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_581551e1-a968-4288-ab1d-ac2e68522e2g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_4f0c4133-2a9f-479a-8076-591b1bdcb1fg\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_2f753d7d-adf7-40e5-9a60-91b70e0e0eeg\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_fb455b6d-69cb-4f92-9adc-c1299b22977g\"],\"snapshotVideos\":[]}},\"mobileIcon\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_b6ecb63b-80ad-499f-8c01-22ede3c7497g\",\"name\":{\"en_us\":\"Mermaid\",\"ja_jp\":\"Mermaid\",\"zh_cn\":\"文本绘图\",\"zh_hk\":\"文字繪圖\",\"zh_tw\":\"文字繪圖\"},\"pcIcon\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_f82c8390-6475-4846-b8f5-907fe50ca30g\"},{\"appId\":\"cli_a3d2183c1d98d013\",\"appName\":{\"en_us\":\"Timeline\",\"ja_jp\":\"タイムライン\",\"zh_cn\":\"时间轴\",\"zh_hk\":\"時間軸\",\"zh_tw\":\"時間軸\"},\"appSceneType\":1,\"blockTypeId\":\"blk_6358a421bca0001c22536e4c\",\"category\":\"docx_extension\",\"contactInfo\":{\"customApp\":{},\"isvApp\":{\"contactDetail\":{\"corpName\":\"北京飞书科技有限公司\",\"email\":\"support@feishu.cn\",\"i18nAgreement\":{\"en_us\":{\"clauseUrl\":\"https://www.feishu.cn/en/terms\",\"privacyPolicyUrl\":\"https://www.feishu.cn/en/privacy\"},\"ja_jp\":{\"clauseUrl\":\"https://www.feishu.cn/terms?lang=zh\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"},\"zh_cn\":{\"clauseUrl\":\"https://www.feishu.cn/terms?lang=zh\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"}},\"officialUrl\":\"https://www.feishu.cn/\",\"phone\":\"400-0682-666\"},\"i18nIsvInfo\":{\"I18nTenantName\":{},\"TenantName\":\"北京飞书科技有限公司\",\"avatarURL\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_2cab041c-1c0d-4e8f-81c8-cbdc1b7763ag~?image_size=noop\\u0026cut_type=\\u0026quality=\\u0026format=image\\u0026sticker_format=.webp\"}}},\"desc\":{\"en_us\":\"Manage your projects by visualizing the key milestones and events in chronological order\",\"ja_jp\":\"プロジェクトのマイルストーン、進捗状況、組織の目標を可視化\",\"zh_cn\":\"图形化表达事件的发展进程\",\"zh_hk\":\"以圖形形式表達事件的發展過程\",\"zh_tw\":\"以圖形形式表達事件的發展過程\"},\"descImage\":{\"en_us\":\"\",\"ja_jp\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_830e84c9-c200-4fb3-8a60-f22e67220e9g\",\"zh_cn\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_e4afa44b-f9e4-4f77-aeb1-0a0876fd4f1g\",\"zh_hk\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_90c40cb9-db13-4149-8e46-9db0747b8b1g\",\"zh_tw\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_9761f81d-8c07-42c6-a31e-e7a36ca9075g\"},\"helpInfo\":{\"en_us\":{\"additionalRemark\":\"This block is a timeline app that graphically shows the process updates, milestones, and key points of projects and events by time, step, and sequence. It helps document editors express information efficiently and vividly and renders readers with an efficient and enjoyable reading experience.\\n\\n- Display key information efficiently: Key years and events are displayed in a chronicle, making it easy for users to understand\\n- Highlight key steps: Key delivery steps and delivery content are highlighted, allowing all project staff to get a clear view of the project\\n- Precisely highlight problems to promote problem-solving: Key problematic steps and solutions are reviewed in project review meetings\",\"helpUse\":\"https://www.feishu.cn/hc/en-US/articles/429331890039\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_05327bc9-84ae-48dd-b8c8-f9fb564c5e2g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_7b1074cf-6a3a-4031-8e99-aa6c1d95a2dg\"],\"snapshotVideos\":[]},\"ja_jp\":{\"additionalRemark\":\"「タイムライン」を使うと、時間や手順、優先順位などを図にして表わすことが可能です。さらに事の経緯やマイルストーン、キーポイントなども可視化されます。生き生きとした表現を効率的に作成可能であるだけでなく、読者からしても、メリハリがついて、飽きることなく読み進めることができるでしょう。\\n\\n- 重要な情報を効率的に提示：節目の年や出来事を、一目瞭然な形で表現できます\\n- キーノードを強調表示：重要な納品時間や納品物を、プロジェクトに関わる全員に直感的に示せます\\n- 問題を精確に見せ、解決を加速：いつどんな問題が起きたか、どうやって解決したか、といった内容も反省会で簡単に振り返ることができます\\n- 豊富なビューをご用意：さまざまなビューが用意されており、ニーズに合わせて自由に選択できます\",\"helpUse\":\"https://www.feishu.cn/hc/articles/429331890039\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_c29df7fa-92ea-4156-a5db-2f9f9e3ad48g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_7e2807ab-900a-4af4-8b6c-f2c6a35211dg\"],\"snapshotVideos\":[]},\"zh_cn\":{\"additionalRemark\":\"时间轴应用，图形化地按时间、步骤、顺序表达项目和事件的发展进程、里程碑、关键点等内容。帮助文档编辑者高效生动表达，阅读者高效愉悦阅读。\\n\\n- 高效展示关键信息：将关键年份和大事记表现出来，用户一目了然\\n- 重点提示关键节点：向项目全员清晰说明关键的时间交付节点及交付内容\\n- 精准凸显问题促解决：项目复盘会中，回顾关键的问题节点及解决方案\",\"helpUse\":\"https://www.feishu.cn/hc/zh-CN/articles/429331890039\",\"snapshotImages\":[\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_8f5e2981-ec0e-4abe-af4c-6167473d0b0g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_7f11ba7d-05d9-4bdd-aec9-23bc9c817d6g\"],\"snapshotVideos\":[]}},\"mobileIcon\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_f7a8423c-9312-41ae-8be0-4566e25228ag\",\"name\":{\"en_us\":\"Timeline\",\"ja_jp\":\"タイムライン\",\"zh_cn\":\"时间轴\",\"zh_hk\":\"時間軸\",\"zh_tw\":\"時間軸\"},\"pcIcon\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_f31724c2-15b5-4d7d-9bdd-55c878409f6g\"},{\"appId\":\"cli_a3d2183c1d98d013\",\"appName\":{\"en_us\":\"Timeline\",\"ja_jp\":\"タイムライン\",\"zh_cn\":\"时间轴\",\"zh_hk\":\"時間軸\",\"zh_tw\":\"時間軸\"},\"appSceneType\":1,\"blockTypeId\":\"blk_6358a421bca0001c1ce11f5f\",\"category\":\"docx_extension\",\"contactInfo\":{\"customApp\":{},\"isvApp\":{\"contactDetail\":{\"corpName\":\"北京飞书科技有限公司\",\"email\":\"support@feishu.cn\",\"i18nAgreement\":{\"en_us\":{\"clauseUrl\":\"https://www.feishu.cn/en/terms\",\"privacyPolicyUrl\":\"https://www.feishu.cn/en/privacy\"},\"ja_jp\":{\"clauseUrl\":\"https://www.feishu.cn/terms?lang=zh\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"},\"zh_cn\":{\"clauseUrl\":\"https://www.feishu.cn/terms?lang=zh\",\"privacyPolicyUrl\":\"https://www.feishu.cn/privacy\"}},\"officialUrl\":\"https://www.feishu.cn/\",\"phone\":\"400-0682-666\"},\"i18nIsvInfo\":{\"I18nTenantName\":{},\"TenantName\":\"北京飞书科技有限公司\",\"avatarURL\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_2cab041c-1c0d-4e8f-81c8-cbdc1b7763ag~?image_size=noop\\u0026cut_type=\\u0026quality=\\u0026format=image\\u0026sticker_format=.webp\"}}},\"desc\":{\"en_us\":\"Insert an Info collector for a quick show of hands\\n\",\"ja_jp\":\"ワンクリックで「情報収集」ブロックを挿入し、手軽に閲覧者の意見を統計します\\n\",\"zh_cn\":\"插入一个“信息收集”，轻松统计用户信息\",\"zh_hk\":\"插入一個“信息收集”，輕鬆統計用戶信息\",\"zh_tw\":\"插入一個“信息收集”，輕鬆統計用戶信息\"},\"descImage\":{\"en_us\":\"\",\"ja_jp\":\"\",\"zh_cn\":\"\",\"zh_hk\":\"\",\"zh_tw\":\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_71597252-7d0b-4a1d-b6a1-c5e47e16015g\"},\"helpInfo\":{\"en_us\":{\"additionalRemark\":\"This block is a timeline app that graphically shows the process updates, milestones, and key points of projects and events by time, step, and sequence. It helps document editors express information efficiently and vividly and renders readers with an efficient and enjoyable reading experience.\\n\\n- Display key information efficiently: Key years and events are displayed in a chronicle, making it easy for users to understand\\n- Highlight key steps: Key delivery steps and delivery content are highlighted, allowing all project staff to get a clear view of the project\\n- Precisely highlight problems to promote problem-solving: Key problematic steps and solutions are reviewed in project review meetings\",\"helpUse\":\"https://www.feishu.cn/hc/en-US/articles/429331890039\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_05327bc9-84ae-48dd-b8c8-f9fb564c5e2g\",\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_7b1074cf-6a3a-4031-8e99-aa6c1d95a2dg\"],\"snapshotVideos\":[]},\"ja_jp\":{\"additionalRemark\":\"「タイムライン」を使うと、時間や手順、優先順位などを図にして表わすことが可能です。さらに事の経緯やマイルストーン、キーポイントなども可視化されます。生き生きとした表現を効率的に作成可能であるだけでなく、読者からしても、メリハリがついて、飽きることなく読み進めることができるでしょう。\\n\\n- 重要な情報を効率的に提示：節目の年や出来事を、一目瞭然な形で表現できます\\n- キーノードを強調表示：重要な納品時間や納品物を、プロジェクトに関わる全員に直感的に示せます\\n- 問題を精確に見せ、解決を加速：いつどんな問題が起きたか、どうやって解決したか、といった内容も反省会で簡単に振り返ることができます\\n- 豊富なビューをご用意：さまざまなビューが用意されており、ニーズに合わせて自由に選択できます\",\"helpUse\":\"https://www.feishu.cn/hc/articles/429331890039\",\"snapshotImages\":[\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_c29df7fa-92ea-4156-a5db-2f9f9e3ad48g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_7e2807ab-900a-4af4-8b6c-f2c6a35211dg\"],\"snapshotVideos\":[]},\"zh_cn\":{\"additionalRemark\":\"时间轴应用，图形化地按时间、步骤、顺序表达项目和事件的发展进程、里程碑、关键点等内容。帮助文档编辑者高效生动表达，阅读者高效愉悦阅读。\\n\\n- 高效展示关键信息：将关键年份和大事记表现出来，用户一目了然\\n- 重点提示关键节点：向项目全员清晰说明关键的时间交付节点及交付内容\\n- 精准凸显问题促解决：项目复盘会中，回顾关键的问题节点及解决方案\",\"helpUse\":\"https://www.feishu.cn/hc/zh-CN/articles/429331890039\",\"snapshotImages\":[\"https://s3-imfile.feishucdn.com/static-resource/v1/v2_8f5e2981-ec0e-4abe-af4c-6167473d0b0g\",\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_7f11ba7d-05d9-4bdd-aec9-23bc9c817d6g\"],\"snapshotVideos\":[]}},\"mobileIcon\":\"https://s1-imfile.feishucdn.com/static-resource/v1/v2_f94ca15c-8356-4d16-8f4d-5269d8dbf25g\",\"name\":{\"en_us\":\"Info Collector\",\"ja_jp\":\"情報収集\",\"zh_cn\":\"信息收集\",\"zh_hk\":\"信息收集\",\"zh_tw\":\"信息收集\"},\"pcIcon\":