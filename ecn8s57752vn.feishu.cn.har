length > 0 ? tokenRegMatch[2] : undefined; const pageId = searchParams.get('pageId'); const appMode = searchParams.get('mode') || 'read'; const v = searchParams.get('v'); const br = searchParams.get('br'); let realAppToken = pathToken; if (window.SERVER_DATA?.metaInfo?.bizType === 1 && window.SERVER_DATA?.meta?.token) { realAppToken = window.SERVER_DATA?.meta?.token; } return { appToken: realAppToken, pathToken, pageId, appMode, v, br, }; } function fetchXHRData(url, params, payload = { method: 'GET' }) { return new Promise((resolve, reject) => { const { method, data } = payload; let fetchUrl = url; if (params) { const separator = fetchUrl.includes('?') ? '&' : '?'; fetchUrl += `${separator}${Object.keys(params) .filter(key => params[key] != null && params[key] !== '') .map(key => `${key}=${params[key]}`) .join('&')}`; } const xhr = new XMLHttpRequest(); xhr.open(method, fetchUrl, true); if (method === 'POST') { xhr.setRequestHeader('Content-Type', 'application/json;charset=UTF-8'); xhr.setRequestHeader('X-Csrftoken', getCookie('_csrf_token') || ''); } xhr.onload = function (e) { if (xhr.status === 200) { let res = {}; try { res = JSON.parse(xhr.responseText); } catch (e) { window.htmlCollectEvent?.('ccm_bitable_load_api_status', { succ: false, path: fetchUrl, msg: e?.message ?? e?.msg, status: xhr.status, logId: xhr.getResponseHeader('x-tt-logId'), entry_tpl_name: window.entryTemplateName, }); console.error('fetchXhrData parse fail', e); } resolve({ ...res, xttLogId: xhr.getResponseHeader('x-tt-logId'), }); } else { console.error(xhr.statusText); const logId = xhr.getResponseHeader('x-tt-logId'); window.htmlCollectEvent?.('ccm_bitable_load_api_status', { succ: false, path: fetchUrl, status: xhr.status, logId, entry_tpl_name: window.entryTemplateName, }); reject({ errText: xhr.statusText, errCode: xhr.status, xttLogId: logId, }); } }; xhr.onerror = function (e) { console.error(xhr.statusText); const logId = xhr.getResponseHeader('x-tt-logId'); window.htmlCollectEvent?.('ccm_bitable_load_api_status', { succ: false, path: fetchUrl, msg: 'xhr onerror', logId, entry_tpl_name: window.entryTemplateName, }); reject({ errText: xhr.statusText, errCode: xhr.status, xttLogId: logId, }); }; xhr.send(data ? JSON.stringify(data) : null); }); } function getOS() { const ua = navigator.userAgent.toLowerCase(); if (ua.includes('android')) { return 'android'; } if (ua.includes('iphone')) { return 'ios'; } if (ua.includes('mac os')) { return 'mac'; } if (ua.includes('windows')) { return 'windows'; } return 'unknown'; } function getLang() { const lang = getCookie('lang'); return lang ? lang : undefined; } function isNotEmpty(obj) { return obj && typeof obj === 'object' && Object.keys(obj).length > 0; } window.baseAppTemplateUtils = { getCookie, setLocalKeyToCookie, getDataFromUrl, fetchXHRData, isNotEmpty, getOS, getLang, }; })();</script><script nonce=\"tZatLtXaRmFAgXIKTTDI7\"  >(function () { window.baseAppLocalSSRWarmupStart = Date.now(); const DB_NAME = 'base_app_local_ssr_db'; const DB_VERSION = 1; const STORE_NAME = 'cache_list'; const META_KEY = 'base_app_local_ssr_cache_meta'; const META_VERSION = 1; const HARD_TTL_MS = 7 * 24 * 60 * 60 * 1000; const SIDEBAR_COLLAPSED_LS_KEY = 'base_app_sidebar_collapsed'; const indexDBOpenWarmup = () => { if (typeof indexedDB !== 'undefined') { window.baseAppLocalSSRIndexDBPromise = new Promise((resolve, reject) => { try { const req = indexedDB.open(DB_NAME, DB_VERSION); req.onupgradeneeded = e => { const db = e.target.result; if (!db.objectStoreNames.contains(STORE_NAME)) { db.createObjectStore(STORE_NAME, { keyPath: 'id' }); } }; req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error); req.onblocked = () => reject(new Error('blocked')); } catch (e) { reject(e); } }); } }; indexDBOpenWarmup(); const recordWarmupFailReason = (failType, msg) => { window.baseAppLocalSSRWarmupReason = { failType: failType, message: msg || '', }; }; const { getDataFromUrl } = window.baseAppTemplateUti